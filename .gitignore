# Tang Dynasty run directories. Everything under here is regenerated from
# HDMI1.4b_Transmitter_v1.0.al by tools/td_build.ps1; only best_result/ is kept,
# because that is the bitstream that actually goes on the board.
src/td_project/HDMI1.4b_Transmitter_v1.0_Runs/syn_1/
src/td_project/HDMI1.4b_Transmitter_v1.0_Runs/phy_1/
src/td_project/log/

# Tang Dynasty run directories for the vision sub-board project. Everything
# under <prj>_Runs/ is regenerated by TD from the matching .al -- and if TD
# ever fails to write the .prj snapshot, tools/td_make_prj.py rebuilds it
# deterministically. None of it is source. (See doc/vision_sub/README.md §6.2.)
src/vision_sub/td_project/*_Runs/
src/vision_sub/td_project/log/
src/vision_sub/td_project/.lock.f

# Local build and diagnostic scratch, not project content.
_baseline_backup/
_build_logs/

# Python.
__pycache__/
*.pyc

# Tool output. The scripts that produce these are tracked; their logs and
# rendered previews are not.
tools/*.log
tools/card_preview/
