# ---------------------------------------------------------------------------
# Board B (Ethernet image front-end) pin constraints -- top = board_b_top
#
# Ported from the vendor UDP.adc. Changes vs the vendor file:
#   - SD-card pins REMOVED (sd_clk/sd_cs/sd_miso/sd_mosi/sd_reset_rd): Board B
#     has no SD card; images arrive over Ethernet.
#   - led[0..2] moved off virtualIO onto the real board LEDs (high-active):
#       led[0]=A4  SDRAM init done
#       led[1]=A3  a BMP header validated at least once (sticky)
#       led[2]=C10 fault: RX FIFO overflow | framer watchdog drop | scaler overflow
#   - SPI master outputs ADDED on the J1 40-pin header (flying leads to Board A).
#
# SPI board-to-board wiring contract (Board B is MASTER, Board A is SLAVE):
#   Board B J1_pin5  (H13) spi_sck   -> Board A SPI slave SCK
#   Board B J1_pin6  (H14) spi_mosi  -> Board A SPI slave MOSI
#   Board B J1_pin7  (J14) spi_cs_n  -> Board A SPI slave CS_n
#   Board B J1_pin12 (GND)           -> Board A GND  (common reference, REQUIRED)
#   All three signals are LVCMOS33 push-pull outputs; SPI mode 0, SCK<=6.25MHz,
#   so plain Dupont leads are fine (no termination, no impedance control needed).
#   The Board A slave .adc must mirror these three nets onto free Board A GPIO.
# ---------------------------------------------------------------------------
set_pin_assignment	{ clk_50 }	{ LOCATION = R7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ sys_rst_n }	{ LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# ---- status LEDs (real, high-active) ----
set_pin_assignment	{ led[0] }	{ LOCATION = A4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[1] }	{ LOCATION = A3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ led[2] }	{ LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# ---- gigabit Ethernet PHY (RGMII), verbatim from the award-winning reference ----
# project (Main/q3q4/top.adc lines 3-14): LVCMOS33, TX DRIVESTRENGTH=16 SLEWRATE=FAST,
# no OUTDEL. Do NOT "fix" this to LVCMOS25: bank 2 shares one VCCIO rail between
# clk_50 (R7) and the whole RGMII group, so mixing standards fails synthesis with
# USR-8001, and the reference project proves LVCMOS33 works on this board.
set_pin_assignment	{ phy1_rgmii_rx_clk }	{ LOCATION = T14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ phy1_rgmii_rx_ctl }	{ LOCATION = T13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ phy1_rgmii_rx_data[0] }	{ LOCATION = P6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ phy1_rgmii_rx_data[1] }	{ LOCATION = M6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ phy1_rgmii_rx_data[2] }	{ LOCATION = T9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ phy1_rgmii_rx_data[3] }	{ LOCATION = N9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ phy1_rgmii_tx_clk }	{ LOCATION = T12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment	{ phy1_rgmii_tx_ctl }	{ LOCATION = T7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment	{ phy1_rgmii_tx_data[0] }	{ LOCATION = T4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment	{ phy1_rgmii_tx_data[1] }	{ LOCATION = T6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment	{ phy1_rgmii_tx_data[2] }	{ LOCATION = M7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }
set_pin_assignment	{ phy1_rgmii_tx_data[3] }	{ LOCATION = T8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; SLEWRATE = FAST; }

# ---- SPI master to Board A (J1 header flying leads) ----
set_pin_assignment	{ spi_sck }	{ LOCATION = H13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ spi_mosi }	{ LOCATION = H14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ spi_cs_n }	{ LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
